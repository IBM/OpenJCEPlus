# OpenJCEPlus Provider Configuration — OpenSSL backend
# Provider name becomes "OpenJCEPlus-OpenSSL" after configure().
# All services listed here use the OpenSSL native implementation.
# Services not listed fall back to the default (OCK) backend.

name = OpenSSL

description = OpenJCEPlus-OpenSSL Provider

# =======================================================================
# SecureRandom (OpenSSL backend; required by AESCipher.engineInit IV generation)
# =======================================================================

Service.SecureRandom.SHA256DRBG = com.ibm.crypto.plus.provider.HASHDRBG$SHA256DRBG
SecureRandom.SHA256DRBG.alias.add = HASHDRBG, SHA2DRBG
SecureRandom.SHA256DRBG.attr.add.ThreadSafe = true
SecureRandom.SHA256DRBG.attr.add.NativeProvider = OpenSSL

Service.SecureRandom.SHA512DRBG = com.ibm.crypto.plus.provider.HASHDRBG$SHA512DRBG
SecureRandom.SHA512DRBG.alias.add = SHA5DRBG
SecureRandom.SHA512DRBG.attr.add.ThreadSafe = true
SecureRandom.SHA512DRBG.attr.add.NativeProvider = OpenSSL

# =======================================================================
# KeyGenerator (required by AES tests that generate keys via provider)
# =======================================================================

KeyGenerator.AES.alias.add = 2.16.840.1.101.3.4.1, OID.2.16.840.1.101.3.4.1
Service.KeyGenerator.AES = com.ibm.crypto.plus.provider.AESKeyGenerator

# DESede KeyGenerator (OCK backend) — needed for testInvalidKeyAlgorithm in AES KeyWrap tests
KeyGenerator.DESede.alias.add = TripleDES, 3DES
Service.KeyGenerator.DESede = com.ibm.crypto.plus.provider.DESedeKeyGenerator

# =======================================================================
# AlgorithmParameters (needed by AESCipher.engineGetParameters and CCM tests)
# =======================================================================

Service.AlgorithmParameters.AES = com.ibm.crypto.plus.provider.AESParameters
AlgorithmParameters.GCM.alias.add = AESGCM
Service.AlgorithmParameters.GCM = com.ibm.crypto.plus.provider.GCMParameters
AlgorithmParameters.CCM.alias.add = AESCCM
Service.AlgorithmParameters.CCM = com.ibm.crypto.plus.provider.CCMParameters
AlgorithmParameterGenerator.GCM.alias.add = AESGCM
Service.AlgorithmParameterGenerator.GCM = com.ibm.crypto.plus.provider.GCMParameterGenerator
AlgorithmParameterGenerator.CCM.alias.add = AESCCM
Service.AlgorithmParameterGenerator.CCM = com.ibm.crypto.plus.provider.CCMParameterGenerator

# =======================================================================
# AES Ciphers (OpenSSL backend)
# =======================================================================

Cipher.AES.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES = com.ibm.crypto.plus.provider.AESCipher

Cipher.AES/GCM/NoPadding.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES/GCM/NoPadding = com.ibm.crypto.plus.provider.AESGCMCipher

Cipher.AES/CCM/NoPadding.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES/CCM/NoPadding = com.ibm.crypto.plus.provider.AESCCMCipher

# AES Key Wrap (OpenSSL backend)
Cipher.AES/KW/NoPadding.alias.add = AESWrap
Cipher.AES/KW/NoPadding.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES/KW/NoPadding = com.ibm.crypto.plus.provider.AESKeyWrapCipher$KW

Cipher.AES/KWP/NoPadding.alias.add = AESWrapPad
Cipher.AES/KWP/NoPadding.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES/KWP/NoPadding = com.ibm.crypto.plus.provider.AESKeyWrapCipher$KWP

Cipher.AES_128/KW/NoPadding.alias.add = AESWrap_128
Cipher.AES_128/KW/NoPadding.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES_128/KW/NoPadding = com.ibm.crypto.plus.provider.AESKeyWrapCipher$KW_128

Cipher.AES_128/KWP/NoPadding.alias.add = AESWrapPad_128
Cipher.AES_128/KWP/NoPadding.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES_128/KWP/NoPadding = com.ibm.crypto.plus.provider.AESKeyWrapCipher$KWP_128

Cipher.AES_192/KW/NoPadding.alias.add = AESWrap_192
Cipher.AES_192/KW/NoPadding.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES_192/KW/NoPadding = com.ibm.crypto.plus.provider.AESKeyWrapCipher$KW_192

Cipher.AES_192/KWP/NoPadding.alias.add = AESWrapPad_192
Cipher.AES_192/KWP/NoPadding.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES_192/KWP/NoPadding = com.ibm.crypto.plus.provider.AESKeyWrapCipher$KWP_192

Cipher.AES_256/KW/NoPadding.alias.add = AESWrap_256
Cipher.AES_256/KW/NoPadding.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES_256/KW/NoPadding = com.ibm.crypto.plus.provider.AESKeyWrapCipher$KW_256

Cipher.AES_256/KWP/NoPadding.alias.add = AESWrapPad_256
Cipher.AES_256/KWP/NoPadding.attr.add.NativeProvider = OpenSSL
Service.Cipher.AES_256/KWP/NoPadding = com.ibm.crypto.plus.provider.AESKeyWrapCipher$KWP_256

# =======================================================================
# MessageDigest
# =======================================================================

MessageDigest.MD5.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.MD5 = com.ibm.crypto.plus.provider.MessageDigest$MD5

MessageDigest.SHA-1.alias.add = SHA, SHA1, OID.1.3.14.3.2.26, 1.3.14.3.2.26
MessageDigest.SHA-1.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA-1 = com.ibm.crypto.plus.provider.MessageDigest$SHA1

MessageDigest.SHA-224.alias.add = OID.2.16.840.1.101.3.4.2.4, 2.16.840.1.101.3.4.2.4, SHA224
MessageDigest.SHA-224.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA-224 = com.ibm.crypto.plus.provider.MessageDigest$SHA224

MessageDigest.SHA-256.alias.add = OID.2.16.840.1.101.3.4.2.1, 2.16.840.1.101.3.4.2.1, SHA2, SHA-2, SHA256
MessageDigest.SHA-256.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA-256 = com.ibm.crypto.plus.provider.MessageDigest$SHA256

MessageDigest.SHA-384.alias.add = OID.2.16.840.1.101.3.4.2.2, 2.16.840.1.101.3.4.2.2, SHA3, SHA-3, SHA384
MessageDigest.SHA-384.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA-384 = com.ibm.crypto.plus.provider.MessageDigest$SHA384

MessageDigest.SHA-512.alias.add = OID.2.16.840.1.101.3.4.2.3, 2.16.840.1.101.3.4.2.3, SHA5, SHA-5, SHA512
MessageDigest.SHA-512.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA-512 = com.ibm.crypto.plus.provider.MessageDigest$SHA512

MessageDigest.SHA-512/224.alias.add = SHA512/224, OID.2.16.840.1.101.3.4.2.5, 2.16.840.1.101.3.4.2.5
MessageDigest.SHA-512/224.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA-512/224 = com.ibm.crypto.plus.provider.MessageDigest$SHA512_224

MessageDigest.SHA-512/256.alias.add = SHA512/256, OID.2.16.840.1.101.3.4.2.6, 2.16.840.1.101.3.4.2.6
MessageDigest.SHA-512/256.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA-512/256 = com.ibm.crypto.plus.provider.MessageDigest$SHA512_256

MessageDigest.SHA3-224.alias.add = SHA3-224, OID.2.16.840.1.101.3.4.2.7, 2.16.840.1.101.3.4.2.7
MessageDigest.SHA3-224.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA3-224 = com.ibm.crypto.plus.provider.MessageDigest$SHA3_224

MessageDigest.SHA3-256.alias.add = SHA3-256, OID.2.16.840.1.101.3.4.2.8, 2.16.840.1.101.3.4.2.8
MessageDigest.SHA3-256.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA3-256 = com.ibm.crypto.plus.provider.MessageDigest$SHA3_256

MessageDigest.SHA3-384.alias.add = SHA3-384, OID.2.16.840.1.101.3.4.2.9, 2.16.840.1.101.3.4.2.9
MessageDigest.SHA3-384.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA3-384 = com.ibm.crypto.plus.provider.MessageDigest$SHA3_384

MessageDigest.SHA3-512.alias.add = SHA3-512, OID.2.16.840.1.101.3.4.2.10, 2.16.840.1.101.3.4.2.10
MessageDigest.SHA3-512.attr.add.NativeProvider = OpenSSL
Service.MessageDigest.SHA3-512 = com.ibm.crypto.plus.provider.MessageDigest$SHA3_512
