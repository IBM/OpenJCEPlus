name = OpenSSL

description = OpenJCEPlus-OpenSSL Provider

# SecureRandom
Service.SecureRandom.SHA256DRBG = com.ibm.crypto.plus.provider.HASHDRBG$SHA256DRBG
SecureRandom.SHA256DRBG.alias.add = HASHDRBG, SHA2DRBG
SecureRandom.SHA256DRBG.attr.add.ThreadSafe = true
SecureRandom.SHA256DRBG.attr.add.NativeProvider = OPENSSL

Service.SecureRandom.SHA512DRBG = com.ibm.crypto.plus.provider.HASHDRBG$SHA512DRBG
SecureRandom.SHA512DRBG.alias.add = SHA5DRBG
SecureRandom.SHA512DRBG.attr.add.ThreadSafe = true
SecureRandom.SHA512DRBG.attr.add.NativeProvider = OPENSSL

